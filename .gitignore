# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Data: DVC tracks pointers; only ignore the data payloads themselves.
# NOTE: never use a bare "data/raw/*" wildcard here. It makes DVC 3.x stop
# discovering the .dvc pointer files (verified on DVC 3.67.1 / Windows).
data/raw/*.csv
data/raw/*.parquet
data/raw/*.json
data/processed/*.csv
data/processed/*.parquet
data/processed/*.json
.dvc/cache/
.dvc/tmp/

# Secrets: never commit
.env
.env.*
!.env.example
.dvc/config.local

# MLflow local artifacts
mlruns/
mlartifacts/

# Editor / OS
.vscode/
.idea/
.DS_Store
